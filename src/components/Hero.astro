---
import { Image } from 'astro:assets';
import Reveal from './Reveal.astro';
import { hero } from '../data/site';
import heroImage from '../assets/interior-great-room.png';
---

<section class="on-dark relative isolate overflow-hidden">
  <!--
    PLACEHOLDER IMAGE. This is an AI-generated interior, not a photograph of
    a Heritage Electric project. It carries no visible text artifacts, which
    is why it survived review, but it should be swapped for a real photograph
    of finished work before launch.
  -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      widths={[900, 1400, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-center"
    />

    <!--
      Scrim is weighted hard to the left so the headline holds contrast while
      the right side keeps the warm lamplight visible. A lighting contractor's
      hero has to actually show the light.
    -->
    <div
      class="absolute inset-0"
      style="background:
        linear-gradient(100deg, rgba(0,26,14,0.92) 0%, rgba(0,30,16,0.74) 34%, rgba(0,36,19,0.34) 62%, rgba(0,40,21,0.10) 100%);"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-2/5"
      style="background: linear-gradient(180deg, rgba(0,26,14,0) 0%, rgba(0,26,14,0.72) 100%);"
    >
    </div>
  </div>

  <div class="shell flex min-h-[92svh] flex-col justify-end pt-36 pb-[clamp(3.5rem,7vw,7rem)]">
    <Reveal>
      <p class="eyebrow">{hero.eyebrow}</p>
    </Reveal>

    <Reveal delay={110}>
      <h1 class="display mt-8 max-w-[19ch]">{hero.heading}</h1>
    </Reveal>

    <Reveal delay={220}>
      <p class="lead mt-8 max-w-[58ch]">{hero.lead}</p>
    </Reveal>

    <Reveal delay={320}>
      <div class="mt-11 flex flex-wrap items-center gap-4">
        <a href={hero.primaryCta.href} class="btn btn-primary">
          {hero.primaryCta.label}
        </a>
        <a href={hero.secondaryCta.href} class="btn btn-ghost">
          {hero.secondaryCta.label}
        </a>
      </div>
    </Reveal>
  </div>
</section>
