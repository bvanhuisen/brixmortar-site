---
import Reveal from './Reveal.astro';
import { hero } from '../data/site';
---

<section class="on-dark relative isolate overflow-hidden">
  <!--
    PHOTOGRAPHY SLOT.
    Replace this block with a full-bleed image of finished work and keep the
    scrim below it. Recommended: 2400px wide, dark or dusk interior, subject
    weighted to the right so the type on the left stays legible.
  -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(120% 90% at 78% 18%, #2b2a27 0%, transparent 58%),
        radial-gradient(80% 60% at 88% 72%, #3a3128 0%, transparent 62%),
        linear-gradient(180deg, #0e0e10 0%, #131315 55%, #0e0e10 100%);"
    >
    </div>

    <!-- Faint architectural grid, the lighting-plan motif. -->
    <svg
      class="absolute inset-0 h-full w-full opacity-[0.13]"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <pattern
          id="grid"
          width="88"
          height="88"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M88 0H0V88"
            fill="none"
            stroke="#a97a2e"
            stroke-width="0.6"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)"></rect>
    </svg>

    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, #0e0e10 6%, rgba(14,14,16,0.72) 46%, rgba(14,14,16,0.25) 100%);"
    >
    </div>
  </div>

  <div class="shell flex min-h-[92svh] flex-col justify-end pt-36 pb-[clamp(3.5rem,7vw,7rem)]">
    <Reveal>
      <p class="eyebrow">{hero.eyebrow}</p>
    </Reveal>

    <Reveal delay={110}>
      <h1 class="display mt-8 max-w-[19ch]">{hero.heading}</h1>
    </Reveal>

    <Reveal delay={220}>
      <p class="lead mt-8 max-w-[58ch]">{hero.lead}</p>
    </Reveal>

    <Reveal delay={320}>
      <div class="mt-11 flex flex-wrap items-center gap-4">
        <a href={hero.primaryCta.href} class="btn btn-primary">
          {hero.primaryCta.label}
        </a>
        <a href={hero.secondaryCta.href} class="btn btn-ghost">
          {hero.secondaryCta.label}
        </a>
      </div>
    </Reveal>
  </div>
</section>
