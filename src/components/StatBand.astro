---
import Reveal from './Reveal.astro';
import { stats } from '../data/site';
---

<section class="on-dark border-t border-line-dark">
  <div class="shell grid grid-cols-1 gap-px sm:grid-cols-3">
    {
      stats.map((stat, i) => (
        <Reveal delay={i * 110}>
          <div class="py-11 sm:py-14 sm:pr-10">
            <p class="text-[clamp(2.25rem,1.5rem+2.4vw,3.5rem)] leading-none font-light tracking-[-0.03em] text-accent">
              {stat.value}
            </p>
            <p class="mt-4 max-w-[26ch] text-[0.9375rem] leading-relaxed text-paper/60">
              {stat.label}
            </p>
          </div>
        </Reveal>
      ))
    }
  </div>
</section>
