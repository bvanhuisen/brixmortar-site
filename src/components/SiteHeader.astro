---
import { site, nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href.replace(/\/$/, '');
---

<header class="fixed inset-x-0 top-0 z-40" data-header>
  <div
    class="transition-colors duration-300"
    data-header-bar
  >
    <div class="shell flex items-center justify-between gap-6 py-5">
      <a
        href="/"
        class="flex items-baseline gap-2 text-current"
        aria-label={`${site.name}, home`}
      >
        <span class="text-[1.0625rem] font-bold tracking-tight">Heritage</span>
        <span class="text-[1.0625rem] font-normal tracking-tight opacity-65">
          Electric
        </span>
      </a>

      <nav class="hidden lg:block" aria-label="Primary">
        <ul class="flex items-center gap-9">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="relative block py-2 text-[0.875rem] font-medium text-current transition-opacity hover:opacity-100 aria-[current=page]:opacity-100"
                  style={isActive(item.href) ? '' : 'opacity:0.72'}
                >
                  {item.label}
                  {isActive(item.href) && (
                    <span class="absolute inset-x-0 -bottom-0.5 h-0.5 bg-current" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={site.phoneHref}
          class="btn btn-ghost hidden text-current sm:inline-flex"
        >
          {site.phone}
        </a>

        <button
          type="button"
          class="btn btn-ghost !min-h-11 !px-4 text-current lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-menu-toggle
        >
          <span data-menu-label>Menu</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile navigation -->
  <div
    id="mobile-nav"
    class="on-dark hidden border-t border-line-dark lg:hidden"
    data-mobile-nav
  >
    <nav class="shell py-4" aria-label="Mobile">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="block border-b border-line-dark py-4 text-[1.0625rem] font-medium aria-[current=page]:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={site.phoneHref}
            class="block py-4 text-[1.0625rem] font-semibold text-accent"
          >
            {site.phone}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const bar = document.querySelector<HTMLElement>('[data-header-bar]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

  // Every page opens on a dark hero, so the header starts light-on-dark and
  // flips to a solid white bar once you scroll past it.
  const solid = ['bg-white', 'text-ink', 'shadow-[0_1px_0_#dcdfdd]'];

  const applyScrollState = () => {
    if (!bar || !header) return;
    const scrolled = window.scrollY > 80;
    const menuOpen = toggle?.getAttribute('aria-expanded') === 'true';

    solid.forEach((c) => bar.classList.toggle(c, scrolled && !menuOpen));
    header.classList.toggle('text-white', !scrolled || !!menuOpen);
  };

  applyScrollState();
  window.addEventListener('scroll', applyScrollState, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    mobileNav?.classList.toggle('hidden', open);
    if (label) label.textContent = open ? 'Menu' : 'Close';
    applyScrollState();
  });
</script>
