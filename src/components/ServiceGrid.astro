---
import Reveal from './Reveal.astro';
import SectionHead from './SectionHead.astro';
import { whatWeDo } from '../data/site';
---

<section id="what-we-do" class="py-(--spacing-section)">
  <div class="shell">
    <SectionHead
      eyebrow={whatWeDo.eyebrow}
      heading={whatWeDo.heading}
      lead={whatWeDo.lead}
    />

    <div class="mt-16 grid gap-px border-t border-line sm:grid-cols-2 lg:grid-cols-4">
      {
        whatWeDo.services.map((service, i) => (
          <Reveal delay={(i % 4) * 90}>
            <article class="group h-full border-b border-line pt-8 pb-10 sm:pr-8">
              <p class="text-[0.72rem] font-medium tracking-[0.14em] text-ink-muted tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-5 text-h3 font-medium">{service.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">
                {service.body}
              </p>
              <span class="mt-6 block h-px w-0 bg-accent transition-[width] duration-500 ease-(--ease-out-soft) group-hover:w-12" />
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
