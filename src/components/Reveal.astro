---
/**
 * Wraps children in a scroll-reveal. `delay` staggers siblings.
 * Honours prefers-reduced-motion via theme.css.
 */
interface Props {
  delay?: number;
  as?: string;
  class?: string;
}

const { delay = 0, as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag data-reveal style={`--reveal-delay:${delay}ms`} class={className}>
  <slot />
</Tag>
