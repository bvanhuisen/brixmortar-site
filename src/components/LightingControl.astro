---
import { Image } from 'astro:assets';
import Reveal from './Reveal.astro';
import { lightingControl } from '../data/site';
// PLACEHOLDER: AI-generated, not a Heritage Electric project. Swap before launch.
import sceneImage from '../assets/exterior-dusk-lighting.png';
---

<section id="lighting-control" class="on-dark py-(--spacing-section)">
  <div class="shell grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-6">
      <Reveal>
        <p class="eyebrow">{lightingControl.eyebrow}</p>
      </Reveal>
      <Reveal delay={90}>
        <h2 class="heading mt-6">{lightingControl.heading}</h2>
      </Reveal>
      <Reveal delay={180}>
        <p class="lead mt-7 max-w-[52ch]">{lightingControl.body}</p>
      </Reveal>
    </div>

    <!--
      PHOTOGRAPHY SLOT: a keypad, a control panel, or a lit room at dusk.
      Swap the whole <Reveal> below for an <img> at 4:5 or 1:1.
    -->
    <Reveal delay={240} class="lg:col-span-6">
      <div
        class="relative aspect-4/5 w-full overflow-hidden border border-line-dark sm:aspect-16/10 lg:aspect-4/5"
      >
        <Image
          src={sceneImage}
          alt="A South Bay home at dusk with the exterior and landscape lighting on"
          widths={[600, 900, 1400]}
          sizes="(min-width: 1024px) 46vw, 100vw"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0"
          style="background: linear-gradient(180deg, rgba(0,32,17,0.32) 0%, rgba(0,32,17,0.62) 55%, rgba(0,32,17,0.82) 100%);"
        >
        </div>

        <!-- Keypad motif. Placeholder until photography lands. -->
        <div class="absolute inset-0 grid place-items-center p-8">
          <div
            class="w-full max-w-[19rem] rounded-[4px] border border-line-dark bg-ink/80 px-7 py-8 backdrop-blur-sm"
            style="box-shadow: 0 30px 70px -20px rgba(0,0,0,0.75), 0 0 90px -30px rgba(10,107,60,0.55);"
          >
            <p class="text-[0.62rem] tracking-[0.2em] text-paper/35 uppercase">
              Great Room
            </p>

            <div class="mt-6 grid gap-5">
              {
                ['Entertain', 'Dining', 'Evening', 'Away'].map((scene, i) => (
                  <div class="flex items-center gap-4">
                    <span
                      class="h-2 w-2 shrink-0 rounded-full"
                      style={
                        i === 1
                          ? 'background:#12b563; box-shadow:0 0 12px 2px rgba(18,181,99,0.65)'
                          : 'background:#2c4a3a'
                      }
                    />
                    <span
                      class={`text-[0.875rem] ${i === 1 ? 'text-paper' : 'text-paper/40'}`}
                    >
                      {scene}
                    </span>
                    <span
                      class="ml-auto h-px flex-1"
                      style={`max-width:${[54, 74, 44, 62][i]}px;background:${i === 1 ? 'rgba(18,181,99,0.55)' : '#2a2a2e'}`}
                    />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>
