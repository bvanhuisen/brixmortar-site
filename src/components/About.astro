---
import Reveal from './Reveal.astro';
import { about, partners } from '../data/site';
---

<section id="about" class="bg-paper-alt py-(--spacing-section)">
  <div class="shell grid gap-14 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      <Reveal>
        <p class="eyebrow">{about.eyebrow}</p>
      </Reveal>
      <Reveal delay={90}>
        <h2 class="heading mt-6">{about.heading}</h2>
      </Reveal>
    </div>

    <div class="lg:col-span-7">
      {
        about.paragraphs.map((para, i) => (
          <Reveal delay={140 + i * 100}>
            <p class="lead mt-0 not-first:mt-6">{para}</p>
          </Reveal>
        ))
      }

      <Reveal delay={360}>
        <div class="mt-14">
          <p class="eyebrow">{partners.eyebrow}</p>
          <ul class="mt-7 grid gap-x-10 gap-y-4 sm:grid-cols-2">
            {
              partners.items.map((item) => (
                <li class="border-t border-line pt-4 text-[0.9375rem] text-ink-soft">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </Reveal>
    </div>
  </div>
</section>
