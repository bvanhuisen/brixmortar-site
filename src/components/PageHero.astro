---
import Reveal from './Reveal.astro';

interface Props {
  eyebrow: string;
  heading: string;
  lead?: string;
}

const { eyebrow, heading, lead } = Astro.props;
---

<section class="on-dark relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(110% 80% at 82% 12%, #0a5c34 0%, transparent 60%),
        linear-gradient(165deg, #044026 0%, #002d17 62%, #002d17 100%);"
    >
    </div>

    <svg
      class="absolute inset-0 h-full w-full opacity-[0.10]"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <pattern id="ph-grid" width="88" height="88" patternUnits="userSpaceOnUse">
          <path d="M88 0H0V88" fill="none" stroke="#ffffff" stroke-width="0.6"
          ></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#ph-grid)"></rect>
    </svg>
  </div>

  <div class="shell pt-40 pb-[clamp(3rem,5vw,5.5rem)] sm:pt-44">
    <Reveal>
      <p class="eyebrow text-white/70">{eyebrow}</p>
    </Reveal>
    <Reveal delay={90}>
      <h1 class="display mt-7 max-w-[18ch]">{heading}</h1>
    </Reveal>
    {
      lead && (
        <Reveal delay={180}>
          <p class="lead mt-7 max-w-[58ch]">{lead}</p>
        </Reveal>
      )
    }
  </div>
</section>
