---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import StatBand from '../components/StatBand.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import LightingControl from '../components/LightingControl.astro';
import WhyUs from '../components/WhyUs.astro';
import About from '../components/About.astro';
import ServiceArea from '../components/ServiceArea.astro';
import ContactBand from '../components/ContactBand.astro';
import SiteFooter from '../components/SiteFooter.astro';

import { site, hero, homeServicesPreview } from '../data/site';
---

<BaseLayout title={`${site.name} | ${site.tagline}`} description={hero.lead}>
  <SiteHeader />

  <main id="main">
    <Hero />
    <StatBand />
    <ServiceGrid
      limit={4}
      moreHref="/services"
      moreLabel="All services"
      eyebrow={homeServicesPreview.eyebrow}
      heading={homeServicesPreview.heading}
      lead={homeServicesPreview.lead}
    />
    <LightingControl />
    <WhyUs />
    <About />
    <ServiceArea />
    <ContactBand />
  </main>

  <SiteFooter />
</BaseLayout>
